{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "noEmit": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true
  },
  "include": ["src", "forge.env.d.ts", "*.config.ts", "forge.config.ts"]
}
